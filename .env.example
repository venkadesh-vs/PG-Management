# ---------------------------------------------------------------------------
# StayFlow — copy to `.env` and fill in. `.env` is git-ignored; never commit it.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string used by Prisma. Server-side only.
DATABASE_URL="postgresql://postgres:password@localhost:5432/stayflow?schema=public"

# --- Auth (required) -------------------------------------------------------
# Signs the session cookie. At least 32 random characters in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"
# Session lifetime in hours.
AUTH_SESSION_HOURS="12"

# --- Demo ------------------------------------------------------------------
# Public demo deployments only: lists the seeded demo accounts and their
# password on the sign-in page. Leave "false" anywhere real clients sign in.
DEMO_MODE="false"

# --- Seed ------------------------------------------------------------------
# The seed WIPES every table. It refuses to run when NODE_ENV=production
# unless ALLOW_SEED="true" is also set.
# Password given to every seeded demo account.
SEED_PASSWORD="StayFlow@2026"

# --- WhatsApp Business API (optional) --------------------------------------
# Leave blank to run in DEMO MODE: messages are written to the in-app outbox
# and clearly labelled as not delivered. Nothing is ever sent without these.
WHATSAPP_PROVIDER="demo"              # demo | meta
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"

# --- Payment gateway (optional) --------------------------------------------
# Leave as "demo" to run the clearly-labelled demo payment flow.
PAYMENT_PROVIDER="demo"               # demo | razorpay
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# --- Email (optional) ------------------------------------------------------
# Invites, password resets and receipts. "demo" stores emails in the outbox
# without sending. For real email: EMAIL_PROVIDER="resend" + an API key and a
# From address on a domain verified in Resend.
EMAIL_PROVIDER="demo"                 # demo | resend
RESEND_API_KEY=""
EMAIL_FROM="StayFlow <no-reply@yourdomain.com>"

# --- Encryption (required once clients connect their own accounts) --------
# Encrypts each client's Razorpay key secret / WhatsApp token at rest.
# 32 random bytes, base64. NEVER change it once data exists.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""

# --- WhatsApp webhook (delivery receipts, STOP opt-outs) -------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""      # any random string; paste the same in Meta
WHATSAPP_APP_SECRET=""                # Meta App > Settings > Basic > App secret

# --- Automation ------------------------------------------------------------
# Shared secret required by POST /api/cron/run (rent generation, reminders,
# subscription billing). Send as `Authorization: Bearer <CRON_SECRET>`.
# At least 16 characters, or the endpoint rejects every token.
CRON_SECRET="change-me-too"

# --- Public / marketing ----------------------------------------------------
NEXT_PUBLIC_APP_NAME="StayFlow"
NEXT_PUBLIC_BUSINESS_WHATSAPP=""      # e.g. 919876543210 (country code, no +)
NEXT_PUBLIC_CONTACT_EMAIL="hello@stayflow.app"
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
# Legal identity, shown on Terms / Privacy / Refund / Contact pages. Razorpay
# checks these during account approval; the DPDP Act needs a grievance contact.
NEXT_PUBLIC_LEGAL_NAME=""             # e.g. "StayFlow Technologies Pvt Ltd"
NEXT_PUBLIC_BUSINESS_ADDRESS=""       # full registered address
NEXT_PUBLIC_JURISDICTION_CITY=""      # e.g. "Chennai"
NEXT_PUBLIC_GRIEVANCE_OFFICER=""      # name of the person
NEXT_PUBLIC_GRIEVANCE_EMAIL=""
# Optional, privacy-friendly analytics. Blank disables all tracking.
NEXT_PUBLIC_ANALYTICS_PROVIDER=""     # "" | plausible | umami
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_SCRIPT=""

# --- File storage (complaint photos, task proof, KYC scans) ---------------
# "local" keeps files in ./storage/uploads (git-ignored, never public). Only
# for a single long-running server — serverless hosts (Netlify, Vercel) lose
# local files, so use "s3" there. Works with AWS S3, Cloudflare R2, MinIO.
# Files are always served through /api/uploads/<id> after an access check;
# S3 downloads are 5-minute presigned links. See docs/storage-setup.md.
STORAGE_PROVIDER="local"              # local | s3
S3_ENDPOINT=""                        # R2: https://<account-id>.r2.cloudflarestorage.com (blank for AWS)
S3_REGION="auto"                      # R2: auto · AWS: e.g. ap-south-1
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
