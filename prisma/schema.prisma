// ---------------------------------------------------------------------------
// StayFlow — an automated operating system for PGs.
//
// Money convention: every monetary column is an Int holding WHOLE RUPEES.
// PG rent, deposits, expenses and settlements are transacted in whole rupees
// in the real world, so this keeps arithmetic exact and JSON-safe (no Decimal
// serialisation across the server/client boundary).
//
// Multi-tenancy: every tenant-scoped row carries `organizationId`. Queries are
// always scoped through `lib/tenancy.ts` — never trust a client-supplied id.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

